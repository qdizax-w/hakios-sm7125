# HakiOS fragment: the sm7125 family -- what is true of the SoC, whatever device it is in.
# Snapdragon 720G: cores 0-5 are Cortex-A55s, 6-7 Cortex-A76s; the CPU clocks are the OSM's (hakios.cpufreq.c knows it by
# the SoC base), not EPSS's; the GPU is an Adreno 618 with a GMU of the older kind.
CONFIG_SOC="sm7125"
CONFIG_CPUS=8
CONFIG_BOOTCPU=7
CONFIG_CPUFREQ=y
CONFIG_HAKIOS_CPUFREQ=y
CONFIG_HAKIOS_ADRENO=y
CONFIG_GPU=y
CONFIG_ADRENO_SPEED=6
CONFIG_HAKIOS_BUTTONS=y
