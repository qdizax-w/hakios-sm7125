# devices/miatoll/drivers/input/conf: the touch screen, of either panel.
# Drivers of this device alone; the mechanism is docs/drivers-config.md, the guide docs/porting/drivers.md.

driver MIATOLL_TOUCH
	file    bsd/dev/hakios.miatoll_touch.c
	help    the touch screen (Redmi Note 9S, 9 Pro, Note 10 Lite), on SPI driven by hand on GPIO 53-56, its firmware
	help    loaded at every boot: the Huaxing panel's FocalTech FT8756 from fw/ft8756.bin (ft8756=1), or the Tianma
	help    panel's Novatek NT36675 from fw/nt36675.bin (nt36675=1)
