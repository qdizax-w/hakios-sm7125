# HakiOS fragment: the Redmi Note 9S / 9 Pro / Note 10 Lite / POCO M2 Pro (miatoll) -- what is true of this device and of no other.
# Every phone driver is left out until it has been made to work here; the arguments only those drivers read go too.
CONFIG_DEVICE="miatoll"
CONFIG_HAKIOS_ADSP=y
# CONFIG_HAKIOS_SPEAKER is not set
CONFIG_HAKIOS_SOUND=y
CONFIG_HAKIOS_MIATOLL_SPEAKER=y
# CONFIG_HAKIOS_MIC is not set
# CONFIG_HAKIOS_BT is not set
# CONFIG_HAKIOS_CAMERA is not set
# CONFIG_HAKIOS_SOCINFO is not set
# CONFIG_HAKIOS_HAPTIC is not set
CONFIG_HAKIOS_MIATOLL_HAPTIC=y
# CONFIG_HAKIOS_GOODIX is not set
CONFIG_HAKIOS_QMI=y
CONFIG_HAKIOS_MODEM=y
# CONFIG_HAKIOS_THERMAL is not set
# CONFIG_HAKIOS_PMIC is not set
# CONFIG_HAKIOS_BATTGUARD is not set
# Wi-Fi: the WCN3990, whose firmware the modem runs (wifi=1 with modem=1); its driver is ath10k (tools/mk-ath10k.sh)
CONFIG_HAKIOS_WIFI=y
# CONFIG_TOUCHSCREEN is not set
# CONFIG_ADSP is not set
# CONFIG_SOUND is not set
# CONFIG_WIFI is not set
# CONFIG_MODEM is not set
# CONFIG_MODEM_AGAIN is not set
# CONFIG_FIRMWARE is "device" in the common kernel: say "none" here until this device's firmware is pulled

# What works on this phone, as the miatoll port had it on 29 October 2026 (docs: device.conf, README.md):
CONFIG_HAKIOS_TORCH=y
CONFIG_TORCH=3
CONFIG_HAKIOS_UFS=y
CONFIG_UFS=2
CONFIG_ROOT_APFS="ufs_darwin"
CONFIG_UFS_WRITE=y
CONFIG_VAR_STORE=y
CONFIG_USBNET=y
CONFIG_FB_SCAN=y
CONFIG_FBSCALE=2
CONFIG_HAKIOS_MIATOLL_TOUCH=y
CONFIG_HAKIOS_MIATOLL_BATTERY=y
CONFIG_HAKIOS_MIATOLL_BACKLIGHT=y
# (ft8756=1, qg=1 and backlight=2 are read by this device's own drivers, which the common catalogue does not scan:
#  they are devices/miatoll/boot.conf's DEVICE_ARGS, added by xl beside these.)
# The battery's service for iOS: hakios_battery_report() (what miatoll's own fuel-gauge driver hands its readings to), the
# kern.hakios.battery_* sysctls SpringBoard reads, and HakiosBattery. It starts nothing here without battery=1, which
# the loader drops on this phone: the readings come from hakios.miatoll_battery.c.
CONFIG_HAKIOS_BATTERY=y
